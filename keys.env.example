# Copy to ~/.config/adcraft-seo/keys.env and paste keys after the = sign (no quotes). All free tiers.
AHREFS_API_KEY=
OPENPAGERANK_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=
# Google Cloud API key with 'PageSpeed Insights API' enabled (can be the same project as Gemini)
GOOGLE_API_KEY=
# Optional
BING_WEBMASTER_API_KEY=
PERPLEXITY_API_KEY=
MOZ_API_TOKEN=

# --- OR, on a shared computer, use the key relay instead of vendor keys (leave the vendor keys blank) ---
RELAY_URL=
RELAY_TOKEN=
